# ==============================================================================
# Google Cloud Lakehouse POC + Google ADK 2.15+ Configuration (.env.example)
# Copy to .env and customize for your environment: cp .env.example .env
# ==============================================================================

# Option A: Gemini API Key (Google AI Studio — supports Gemini 4 Neon, Carbon, Hydrogen, Argon & 3.8 Flash)
# GOOGLE_API_KEY=your-gemini-api-key

# Option B: Vertex AI / Gemini Enterprise Agent Platform
# Tip: Keep GOOGLE_CLOUD_LOCATION=global to serve Gemini 4 models without the 10% regional
# endpoint premium, while keeping BQ_LOCATION=us-east4 co-located near AWS us-east-1.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=omni-retail-lakehouse-prod
PROJECT_ID=omni-retail-lakehouse-prod
GOOGLE_CLOUD_LOCATION=global

# Multi-Model Routing Profile (Nov 2026 Gemini 4 family):
#   - tiered (default): Coordinator=gemini-4-neon, Analyst=gemini-4-carbon, FinOps=gemini-4-hydrogen
#   - argon-tiered    : Coordinator=gemini-4-argon, Analyst=gemini-4-carbon, FinOps=gemini-3.8-flash
#   - neon            : All agents use gemini-4-neon (fast frontier intelligence)
#   - carbon          : All agents use gemini-4-carbon (deepest multi-step reasoning)
#   - argon           : All agents use gemini-4-argon (flagship autonomous engineering)
#   - hydrogen        : All agents use gemini-4-hydrogen (Gemini 4 Flash-tier efficiency)
#   - flash           : All agents use gemini-3.8-flash (lowest-cost POC baseline)
MODEL_PROFILE=tiered

# Optional per-role or global model overrides (uncomment to customize):
# COORDINATOR_MODEL=gemini-4-neon
# ANALYST_MODEL=gemini-4-carbon
# FINOPS_MODEL=gemini-4-hydrogen
# GEMINI_MODEL=gemini-4-neon

# Explicit output cap for Gemini 4's 1M-token decode window
MAX_OUTPUT_TOKENS=8192

# BigQuery ADK Write Mode & Agent Analytics Streaming:
#   - protected (default): Rejects permanent table writes via dry-run while allowing session-scoped
#                          anonymous temp tables for `detect_anomalies` and `analyze_contribution`.
#   - blocked            : Strictly SELECT-only queries (`execute_sql` + `forecast`).
BQ_WRITE_MODE=protected
ENABLE_BQ_AGENT_ANALYTICS=false
BQ_AGENT_ANALYTICS_DATASET=commerce_core

# BigQuery & Lakehouse Regional Co-location (us-east4 pairs with AWS us-east-1 for minimal latency)
GCP_REGION=us-east4
BQ_LOCATION=us-east4

# Lakehouse Federated Catalog Identifiers (4-part SQL: project.catalog.namespace.table)
UNITY_FED_CATALOG_ID=dbx_unity_merch
GLUE_CATALOG_ID=aws_glue_logistics
NATIVE_BQ_DATASET=commerce_core

# Optional OAuth Client ID/Secret for End-User Identity Propagation to Unity Catalog
# (Used in `adk web` when `--federated-catalog-identity-mode=user-identity-federation` is enabled)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# FinOps Guardrails
MAX_BYTES_BILLED_PER_QUERY=10737418240  # 10 GiB cap per agent SQL query
AWS_PUBLIC_EGRESS_USD_PER_GB=0.09
AWS_CCI_EGRESS_USD_PER_GB=0.02
