# ==============================================================================
# Google Cloud Borderless Lakehouse POC + ADK Agent Configuration (.env.example)
# Copy to .env and customize for your environment: cp .env.example .env
# ==============================================================================

# Option A: Gemini API Key (Google AI Studio — supports Gemini 4 Carbon/Argon on paid tier & 3.8 Flash)
# GOOGLE_API_KEY=your-gemini-api-key

# Option B: Vertex AI / Gemini Enterprise Agent Platform
# Tip: Keep GOOGLE_CLOUD_LOCATION=global to serve Gemini 4 Argon/Carbon & 3.8 Flash without
# the 10% regional endpoint premium, while keeping BQ_LOCATION=us-east4 near AWS us-east-1.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=omni-retail-lakehouse-prod
PROJECT_ID=omni-retail-lakehouse-prod
GOOGLE_CLOUD_LOCATION=global

# Multi-Model Routing Profile:
#   - tiered (default): Coordinator=gemini-4-argon, Analyst=gemini-4-carbon, FinOps=gemini-3.8-flash
#   - argon           : All agents use gemini-4-argon (fast Gemini 4 frontier loop)
#   - carbon          : All agents use gemini-4-carbon (deepest multi-step reasoning)
#   - flash           : All agents use gemini-3.8-flash (lowest-cost POC baseline)
MODEL_PROFILE=tiered

# Optional per-role or global model overrides (uncomment to customize):
# COORDINATOR_MODEL=gemini-4-argon
# ANALYST_MODEL=gemini-4-carbon
# FINOPS_MODEL=gemini-3.8-flash
# GEMINI_MODEL=gemini-4-argon

# Explicit output cap for Gemini 4's 1M-token decode window
MAX_OUTPUT_TOKENS=8192

# BigQuery & Lakehouse Regional Co-location (us-east4 pairs with AWS us-east-1 for minimal latency)
GCP_REGION=us-east4
BQ_LOCATION=us-east4

# Lakehouse Federated Catalog Identifiers (4-part SQL: project.catalog.namespace.table)
UNITY_FED_CATALOG_ID=dbx_unity_merch
GLUE_CATALOG_ID=aws_glue_logistics
NATIVE_BQ_DATASET=commerce_core

# Optional OAuth Client ID/Secret for End-User Identity Propagation to Unity Catalog
# (Used in `adk web` when `--federated-catalog-identity-mode=user-identity-federation` is enabled)
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# FinOps Guardrails
MAX_BYTES_BILLED_PER_QUERY=10737418240  # 10 GiB cap per agent SQL query
AWS_PUBLIC_EGRESS_USD_PER_GB=0.09
AWS_CCI_EGRESS_USD_PER_GB=0.02
